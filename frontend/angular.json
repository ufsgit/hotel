{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "guest-widget": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/guest-widget",
      "sourceRoot": "projects/guest-widget/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/guest-widget",
            "index": "projects/guest-widget/src/index.html",
            "browser": "projects/guest-widget/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/guest-widget/tsconfig.app.json",
            "assets": [
              "projects/guest-widget/src/favicon.ico",
              "projects/guest-widget/src/assets"
            ],
            "styles": [
              "projects/guest-widget/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "guest-widget:build:production"
            },
            "development": {
              "buildTarget": "guest-widget:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "guest-widget:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/guest-widget/tsconfig.spec.json",
            "assets": [
              "projects/guest-widget/src/favicon.ico",
              "projects/guest-widget/src/assets"
            ],
            "styles": [
              "projects/guest-widget/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    },
    "admin-dashboard": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/admin-dashboard",
      "sourceRoot": "projects/admin-dashboard/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/admin-dashboard",
            "index": "projects/admin-dashboard/src/index.html",
            "browser": "projects/admin-dashboard/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/admin-dashboard/tsconfig.app.json",
            "assets": [
              "projects/admin-dashboard/src/favicon.ico",
              "projects/admin-dashboard/src/assets"
            ],
            "styles": [
              "projects/admin-dashboard/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "admin-dashboard:build:production"
            },
            "development": {
              "buildTarget": "admin-dashboard:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "admin-dashboard:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/admin-dashboard/tsconfig.spec.json",
            "assets": [
              "projects/admin-dashboard/src/favicon.ico",
              "projects/admin-dashboard/src/assets"
            ],
            "styles": [
              "projects/admin-dashboard/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
